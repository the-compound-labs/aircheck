# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next 16 rewrites these on every dev run
AGENTS.md
CLAUDE.md
/review/
/.open-next/
/.wrangler/
.open-next/
.wrangler/

# your own config (copy aircheck.config.example.json); preview runs live in dataDir (~/.aircheck), never in the repo
/aircheck.config.json

# your Cloudflare deploy config (copy wrangler.example.jsonc)
/wrangler.jsonc

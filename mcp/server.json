{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.the-compound-labs/aircheck",
  "title": "Aircheck",
  "description": "Queues posts as JSON manifests on your machine and re-runs one post's pipeline locally. Never posts.",
  "repository": {
    "url": "https://github.com/the-compound-labs/aircheck",
    "source": "github",
    "subfolder": "mcp"
  },
  "websiteUrl": "https://aircheck.dev",
  "version": "0.6.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "aircheck-mcp",
      "version": "0.6.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AIRCHECK_CONFIG",
          "description": "Path to aircheck.config.json. Optional.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "AIRCHECK_TOKEN",
          "description": "Machine token for an aircheck.dev account. Optional.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}

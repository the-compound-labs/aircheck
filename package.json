{
  "name": "aircheck",
  "version": "0.2.0",
  "private": true,
  "description": "A local studio for agent-run social lanes: today's queue, every media asset, and on-demand preview runs.",
  "scripts": {
    "dev": "next dev -p 3326",
    "build": "next build",
    "start": "next start -p 3326",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",

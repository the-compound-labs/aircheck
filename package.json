    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opennextjs/cloudflare": "1.20.13",
    "@phosphor-icons/web": "^2.1.1",
    "next": "^16.4.6",
    "posthog-js": "^1.407.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "wrangler": "4.148.0"
  }
}
